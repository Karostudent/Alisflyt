@model IEnumerable<Alisflyt.Web.ViewModels.GrantCases.GrantCaseListItemViewModel>

@{
	ViewData["Title"] = "Søknader";
}

<div class="d-flex justify-content-between mb-3">
	<h2>Søknader</h2>
	<a class="btn btn-primary" asp-action="Create" asp-controller="GrantCases">Ny søknad</a>
</div>

@{
	var grantCases = Model ?? System.Array.Empty<Alisflyt.Web.ViewModels.GrantCases.GrantCaseListItemViewModel>();
}

@if (!grantCases.Any())
{
	<div class="alert alert-info">Ingen søknader funnet.</div>
}
else
{
	<table class="table table-striped sortable-table">
		<thead>
			<tr>
				<th data-sortable="true" tabindex="0" role="button" aria-sort="none">Saksnummer <span class="sort-indicator"></span></th>
				<th data-sortable="true" tabindex="0" role="button" aria-sort="none">HPR <span class="sort-indicator"></span></th>
				<th data-sortable="true" tabindex="0" role="button" aria-sort="none">Status <span class="sort-indicator"></span></th>
				<th data-sortable="true" tabindex="0" role="button" aria-sort="none">Endret <span class="sort-indicator"></span></th>
				<th></th>
			</tr>
		</thead>
		<tbody>
		@foreach (var item in grantCases)
		{
			<tr>
				<td>@item.CaseNumber</td>
				<td>@item.HprNumber</td>
		<td>@(item.Status == Alisflyt.Domain.Enums.GrantCaseStatus.Draft ? "Utkast" : item.Status == Alisflyt.Domain.Enums.GrantCaseStatus.Submitted ? "Innsendt" : item.Status == Alisflyt.Domain.Enums.GrantCaseStatus.UnderReview ? "Under behandling" : item.Status == Alisflyt.Domain.Enums.GrantCaseStatus.ReturnedForCorrection ? "Returnert for korrigering" : item.Status.ToString())</td>
				<td data-sort-value="@item.LastModifiedAtUtc.ToLocalTime().ToString("o")">@item.LastModifiedAtUtc.ToLocalTime().ToString("g")</td>
				<td>
					<a class="btn btn-sm btn-link" asp-action="Details" asp-route-id="@item.Id">Vis</a>
				</td>
			</tr>
		}
		</tbody>
	</table>
}
