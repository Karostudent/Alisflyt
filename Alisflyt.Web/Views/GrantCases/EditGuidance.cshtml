@model Alisflyt.Web.ViewModels.Guidance.GuidanceCorrectionEditViewModel
@{
	ViewData["Title"] = "Korriger veiledningstimer";
}

<div class="container py-4">
	<header class="mb-4">
		<p class="text-uppercase text-primary fw-semibold mb-1">ALIS · KORRIGER VEILEDNING</p>
		<h1 class="mb-1">Korriger veiledningstimer</h1>
		<p class="text-muted mb-0">Sak @Model.CaseNumber</p>
	</header>

	@if (!ViewData.ModelState.IsValid)
	{
		<div class="alert alert-danger" role="alert">
			<div asp-validation-summary="ModelOnly"></div>
		</div>
	}

	<div class="card card-body mb-4">
		<h2 class="h5">Korrigeringsbegrunnelse</h2>
		@if (!string.IsNullOrWhiteSpace(Model.CorrectionReason))
		{
			<p class="mb-0">@Model.CorrectionReason</p>
		}
		else
		{
			<p class="text-muted mb-0">Veilederen har bedt om korrigering av attesten.</p>
		}
	</div>

	<form asp-action="UpdateGuidance" method="post">
		@Html.AntiForgeryToken()
		<input type="hidden" name="id" value="@Model.CaseId" />

		<div class="card card-body mb-4">
			<h2 class="h5">Registrerte veiledningstimer</h2>
			@for (var i = 0; i < Model.Sessions.Count; i++)
			{
				<div class="border rounded p-3 mb-3">
					<div class="row g-3">
						<div class="col-md-3">
							<label asp-for="Sessions[i].Date" class="form-label">Dato</label>
							<input asp-for="Sessions[i].Date" class="form-control" type="date" />
							<span asp-validation-for="Sessions[i].Date" class="text-danger"></span>
						</div>
						<div class="col-md-3">
							<label asp-for="Sessions[i].Hours" class="form-label">Timer</label>
							<input asp-for="Sessions[i].Hours" class="form-control" step="0.25" min="0.25" />
							<span asp-validation-for="Sessions[i].Hours" class="text-danger"></span>
						</div>
						<div class="col-md-6">
							<label asp-for="Sessions[i].Topic" class="form-label">Tema</label>
							<input asp-for="Sessions[i].Topic" class="form-control" />
							<span asp-validation-for="Sessions[i].Topic" class="text-danger"></span>
						</div>
					</div>
				</div>
			}
		</div>

		<div class="d-flex gap-2 flex-wrap">
			<button type="submit" class="btn btn-primary">Oppdater veiledningstimer</button>
			<a asp-controller="GrantCases" asp-action="Details" asp-route-id="@Model.CaseId" class="btn btn-outline-secondary">Avbryt</a>
		</div>
	</form>
</div>
