@model Alisflyt.Web.ViewModels.Guidance.GuidanceCorrectionEditViewModel
@{
	ViewData["Title"] = "Korriger veiledningstimer";
}

<div class="container py-4">
	<header class="mb-4">
		<p class="text-uppercase text-primary fw-semibold mb-1">ALIS · KORRIGER VEILEDNING</p>
		<h1 class="mb-1">Korriger veiledningstimer</h1>
		<p class="text-muted mb-0">Sak @Model.CaseNumber</p>
	</header>

	@if (!ViewData.ModelState.IsValid)
	{
		<div class="alert alert-danger" role="alert">
			<div asp-validation-summary="All"></div>
		</div>
	}

	<div class="card card-body mb-4">
		<h2 class="h5">Korrigeringsbegrunnelse</h2>
		@if (!string.IsNullOrWhiteSpace(Model.CorrectionReason))
		{
			<p class="mb-0">@Model.CorrectionReason</p>
		}
		else
		{
			<p class="text-muted mb-0">Veilederen har bedt om korrigering av attesten.</p>
		}
	</div>

	<form asp-controller="GrantCases" asp-action="UpdateGuidance" asp-route-id="@Model.CaseId" method="post" data-guidance-correction-form>
		@Html.AntiForgeryToken()
		<input type="hidden" asp-for="CaseId" />
		<input type="hidden" name="id" value="@Model.CaseId" />

		<div class="card card-body mb-4">
			<h2 class="h5">Registrerte veiledningstimer</h2>
			<p class="text-muted">Endre, fjern eller legg til økter før du sender veiledningen til ny godkjenning.</p>
			<div id="guidance-session-rows">
				@for (var i = 0; i < (Model.Sessions?.Count ?? 0); i++)
				{
					<div class="guidance-session-row border rounded p-3 mb-3">
						<div class="row g-3">
							<div class="col-md-3">
								<label for="Sessions_@(i)__Date" class="form-label">Dato</label>
								<input name="Sessions[@i].Date" id="Sessions_@(i)__Date" value="@(Model.Sessions[i].Date?.ToString("yyyy-MM-dd"))" class="form-control" type="date" />
							</div>
							<div class="col-md-3">
								<label for="Sessions_@(i)__Hours" class="form-label">Timer</label>
								<input name="Sessions[@i].Hours" id="Sessions_@(i)__Hours" value="@Model.Sessions[i].Hours" class="form-control" type="number" inputmode="numeric" step="1" min="1" max="24" />
							</div>
							<div class="col-md-6">
								<label for="Sessions_@(i)__Topic" class="form-label">Tema</label>
								<input name="Sessions[@i].Topic" id="Sessions_@(i)__Topic" value="@Model.Sessions[i].Topic" class="form-control" />
							</div>
						</div>
						<button type="button" class="btn btn-outline-danger mt-3" data-remove-guidance-session>Fjern økt</button>
					</div>
				}
			</div>
			<button type="button" id="add-guidance-session" class="btn btn-outline-primary">+ Legg til veiledningsøkt</button>
		</div>

		<div class="d-flex gap-2 flex-wrap">
			<button type="submit" class="btn btn-primary">Lagre og send korrigert veiledning til godkjenning</button>
			<a asp-controller="GrantCases" asp-action="Details" asp-route-id="@Model.CaseId" class="btn btn-outline-secondary">Avbryt</a>
		</div>
	</form>
</div>

<template id="guidance-session-template">
	<div class="guidance-session-row border rounded p-3 mb-3">
		<div class="row g-3">
			<div class="col-md-3">
				<label for="Sessions_0__Date" class="form-label">Dato</label>
				<input name="Sessions[0].Date" id="Sessions_0__Date" class="form-control" type="date" />
			</div>
			<div class="col-md-3">
				<label for="Sessions_0__Hours" class="form-label">Timer</label>
				<input name="Sessions[0].Hours" id="Sessions_0__Hours" class="form-control" type="number" inputmode="numeric" step="1" min="1" max="24" />
			</div>
			<div class="col-md-6">
				<label for="Sessions_0__Topic" class="form-label">Tema</label>
				<input name="Sessions[0].Topic" id="Sessions_0__Topic" class="form-control" />
			</div>
		</div>
		<button type="button" class="btn btn-outline-danger mt-3" data-remove-guidance-session>Fjern økt</button>
	</div>
</template>

@section Scripts {
	<script src="~/js/edit-guidance.js" asp-append-version="true"></script>
}
