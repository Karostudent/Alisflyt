@{
	ViewData["Title"] = "Om ALISflyt";
}

<div class="row justify-content-center">
	<div class="col-xl-10">
		<div class="card shadow-sm border-0">
			<div class="card-body p-4 p-lg-5">
				<h1 class="display-6 mb-3">Om ALISflyt</h1>

				<p class="lead">
					ALISflyt er en presentasjonsklar demo av en digital søknads- og saksbehandlingsløsning for kommunale ALIS-tilskudd.
				</p>

				<p>
					Løsningen samler søknadsopplysninger, beregningsgrunnlag og saksbehandling i én arbeidsflyt, slik at informasjon kan registreres én gang og brukes videre gjennom prosessen. I denne versjonen er dette koblet opp som en brukerorientert prototype med demo-innlogging og rollebasert visning.
				</p>

				<div class="row g-4 mt-2">
					<div class="col-md-6">
						<div class="border rounded p-3 h-100">
							<h2 class="h5">Hva løsningen håndterer i dag</h2>
							<ul class="mb-0">
								<li>Demo-innlogging for ALIS, koordinator, veileder og administrator</li>
								<li>Opprettelse, lagring og redigering av utkast</li>
								<li>Registrering av søknadsopplysninger og stillingsperioder</li>
								<li>Automatisk beregning av tilskudd basert på søknadsdata</li>
								<li>Koordinatorflyt med vurdering, retur og korrigering</li>
								<li>Visning av saker filtrert på innlogget ALIS-bruker</li>
							</ul>
						</div>
					</div>

					<div class="col-md-6">
						<div class="border rounded p-3 h-100">
							<h2 class="h5">Hva som fortsatt er prototype</h2>
							<ul class="mb-0">
								<li>Det er ikke reell autentisering eller sikkerhetsmodell</li>
								<li>Tilgangsstyring er implementert som demo-logikk, ikke produksjonsklar autorisering</li>
								<li>Veilederflyten er fortsatt en planlagt funksjonalitet</li>
								<li>Integrasjoner, arkiv, varsel og full produktionsoppsett mangler</li>
							</ul>
						</div>
					</div>
				</div>

				<div class="mt-4 alert alert-info mb-0" role="alert">
					ALISflyt er i dag en demo- og presentasjonsløsning som viser hvordan en digital arbeidsflyt kan være strukturert og hvordan roller kan tre inn i samme system. Den skal fortsatt forstås som en prototype i utvikling, ikke som et ferdig produksjonssystem.
				</div>
			</div>
		</div>
	</div>
</div>
