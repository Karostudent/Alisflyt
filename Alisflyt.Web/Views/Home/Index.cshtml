@model Alisflyt.Web.ViewModels.Home.LandingViewModel
@{
    ViewData["Title"] = "Forside";
}

<div class="row justify-content-center mb-4">
    <div class="col-xl-10">
        <div class="hero-panel card border-0">
            <div class="card-body p-4 p-lg-5">
                <p class="eyebrow mb-2">ALISflyt</p>
                <h1 class="hero-title mb-3">Enklere søknad og behandling av ALIS-tilskudd</h1>
                <p class="hero-subtitle mb-0">
                    En felles digital arbeidsflate for ALIS-leger, veiledere og kommunal saksbehandling.
                </p>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.CurrentUserName))
{
    <div class="alert alert-success current-user-alert d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4" role="alert">
        <div>
            <strong>Innlogget:</strong> @Model.CurrentUserName
            <span class="ms-2 text-muted">@string.Join(", ", Model.Roles)</span>
        </div>
        <a class="btn btn-primary" asp-controller="Account" asp-action="RoleHome">Gå til portalen</a>
    </div>
}
else
{
    <div class="text-center mb-4">
        <p class="text-muted">Logg inn for å åpne arbeidsområdet ditt.</p>
        <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Logg inn</a>
    </div>
}

<section class="row g-4" aria-labelledby="overview-title">
    <div class="col-md-3">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h2 id="overview-title" class="h4">ALIS</h2>
                <p class="mb-0">Opprett, rediger og send inn egne søknader.</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h2 class="h4">Veileder</h2>
                <p class="mb-0">Se og behandle veiledningsattester som er koblet til ditt HPR-nummer.</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h2 class="h4">Avdelingsleder</h2>
                <p class="mb-0">Behandle innsendte søknader i kommunen.</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h2 class="h4">Administrator</h2>
                <p class="mb-0">Administrer brukere og tildel roller i ALISflyt.</p>
            </div>
        </div>
    </div>
</section>
