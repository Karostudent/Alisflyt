@model Alisflyt.Application.Models.GrantCaseDto
@using Alisflyt.Domain.Enums
@{
    ViewData["Title"] = "Veiledningsattest";
    var approval = ViewData["GuidanceApproval"] as Alisflyt.Domain.Entities.GuidanceApproval;
    var guidanceCalculation = ViewData["GuidanceCalculation"] as Alisflyt.Web.ViewModels.Guidance.GuidanceCalculationViewModel;
    var requiresGuidanceApproval = ViewData["RequiresGuidanceApproval"] as bool? ?? false;
    var sessions = Model.ApplicationData?.Certificate?.Sessions ?? new List<Alisflyt.Domain.Forms.SupervisionSessionInputModel>();
    var totalHours = sessions.Sum(s => s.Hours ?? 0m);
    var approvalConfirmationError = TempData["ApprovalConfirmationError"] as string;
    var correctionReasonError = TempData["CorrectionReasonError"] as string;
    var correctionReason = TempData["CorrectionReason"] as string ?? string.Empty;
}

<div class="container py-4">
    <h1 class="mb-3">Veiledningsattest</h1>
    <p class="text-muted mb-4">Sak @Model.CaseNumber</p>

    @if (TempData["Error"] is string error && approvalConfirmationError is null && correctionReasonError is null)
    {
        <div class="alert alert-danger">@error</div>
    }
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <section class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <h2 class="h4">ALIS og attest</h2>
                    <dl class="row mb-0">
                        <dt class="col-sm-5">ALIS-lege</dt>
                        <dd class="col-sm-7">@Model.ApplicationData?.Certificate?.DoctorName</dd>
                        <dt class="col-sm-5">HPR-nummer</dt>
                        <dd class="col-sm-7">@Model.HprNumber</dd>
                        <dt class="col-sm-5">Saksnummer</dt>
                        <dd class="col-sm-7">@Model.CaseNumber</dd>
                        <dt class="col-sm-5">Relevant periode</dt>
                        <dd class="col-sm-7">@(sessions.Any(s => s.Date.HasValue) ? $"{sessions.Where(s => s.Date.HasValue).Min(s => s.Date!.Value):dd.MM.yyyy} - {sessions.Where(s => s.Date.HasValue).Max(s => s.Date!.Value):dd.MM.yyyy}" : "-")</dd>
                        <dt class="col-sm-5">Godkjenningsstatus</dt>
                        <dd class="col-sm-7">
                            @if (approval is null)
                            {
                                if (requiresGuidanceApproval)
                                {
                                    <span class="badge text-bg-secondary">Ingen aktiv godkjenningsforespørsel</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Godkjenning ikke påkrevd</span>
                                }
                            }
                            else if (approval.Status == GuidanceApprovalStatus.Approved)
                            {
                                <div class="alert alert-success mb-0 py-2" role="status"><strong>✓</strong> Veiledningsattest godkjent</div>
                            }
                            else if (approval.Status == GuidanceApprovalStatus.NeedsCorrection)
                            {
                                <div class="alert alert-danger mb-0 py-2" role="alert"><strong aria-hidden="true">⚠</strong> Veiledningsattest må korrigeres</div>
                            }
                            else if (approval.Status == GuidanceApprovalStatus.Pending)
                            {
                                <div class="alert alert-secondary mb-0 py-2" role="status"><strong aria-hidden="true">◷</strong> Avventer godkjenning fra veileder</div>
                            }
                            else
                            {
                                <div class="alert alert-secondary mb-0 py-2" role="status">Denne attestversjonen er erstattet av en nyere versjon.</div>
                            }
                        </dd>
                    </dl>
                </div>
            </section>
        </div>

        <div class="col-lg-6">
            <section class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <h2 class="h4">Godkjenningsstatus</h2>
                    @if (approval is null)
                    {
                        if (requiresGuidanceApproval)
                        {
                            <p class="text-warning mb-0">Det finnes ingen aktiv godkjenningsforespørsel for denne attestversjonen.</p>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Godkjenning er ikke påkrevd for denne attesten.</p>
                        }
                    }
                    else
                    {
                        <dl class="row mb-0">
                            <dt class="col-sm-5">Status</dt>
                            <dd class="col-sm-7">@ViewData["GuidanceStatusText"]</dd>
                            <dt class="col-sm-5">Versjon</dt>
                            <dd class="col-sm-7">@approval.VersionNumber</dd>
                            @if (approval.Status == GuidanceApprovalStatus.Approved)
                            {
                                <dt class="col-sm-5">Godkjent av</dt>
                                <dd class="col-sm-7">@approval.ApprovedBy</dd>
                                <dt class="col-sm-5">Godkjent tidspunkt</dt>
                                <dd class="col-sm-7">@(approval.ApprovedAtUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(approval.RequestedRevisionReason))
                            {
                                <dt class="col-sm-5">Begrunnelse</dt>
                                <dd class="col-sm-7">@approval.RequestedRevisionReason</dd>
                            }
                        </dl>
                    }
                </div>
            </section>
        </div>
    </div>

    <section class="card card-body mb-4 border-0 shadow-sm">
        <h2 class="h4">Registrerte veiledningstimer</h2>
        @if (sessions.Count == 0)
        {
            <p class="text-muted mb-0">Ingen registrerte veiledningstimer er knyttet til denne attesten.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0 sortable-table">
                    <thead>
                        <tr>
                            <th scope="col" data-sortable="true" data-sort-type="date" tabindex="0" role="button" aria-sort="none">Dato <span class="sort-indicator"></span></th>
                            <th scope="col" data-sortable="true" data-sort-type="text" tabindex="0" role="button" aria-sort="none">Tema <span class="sort-indicator"></span></th>
                            <th scope="col" data-sortable="true" data-sort-type="number" tabindex="0" role="button" aria-sort="none">Timer <span class="sort-indicator"></span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in sessions.OrderBy(s => s.Date ?? DateOnly.MinValue))
                        {
                            <tr>
                                <td data-sort-value="@(session.Date?.ToString("yyyy-MM-dd") ?? string.Empty)">@(session.Date?.ToString("dd.MM.yyyy") ?? "-")</td>
                                <td>@(session.Topic ?? "-")</td>
                                <td data-sort-value="@(session.Hours?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")">@(session.Hours?.ToString("0.##") ?? "0")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th scope="row" colspan="2">Totalt antall timer</th>
                            <td>@totalHours.ToString("0.##")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </section>

    <section class="card card-body mb-4 border-0 shadow-sm">
        <h2 class="h4">Beregnet beløp for veiledning</h2>
        @if (guidanceCalculation is null || !guidanceCalculation.IsAvailable)
        {
            <p class="text-muted mb-0">Beregning for veiledning er ikke tilgjengelig for denne søknaden.</p>
        }
        else
        {
            <div class="alert alert-light border mb-3">
                <strong>Foreløpig beregnet beløp.</strong> Endelig beløp avhenger av saksbehandling og godkjenning.
            </div>
            <dl class="row mb-0">
                <dt class="col-sm-5">Veiledningsbeløp</dt>
                <dd class="col-sm-7">@guidanceCalculation.GuidanceAmount.ToString("N0") kr</dd>
                <dt class="col-sm-5">Beregnet veilederhonorar basert på registrerte timer</dt>
                <dd class="col-sm-7">
                    @guidanceCalculation.GuidanceHonorariumAmount.ToString("N2") kr
                    @if (guidanceCalculation.GuidanceHonorariumApprovalStatus == GuidanceApprovalStatus.Approved)
                    {
                        <span class="text-success">(attest godkjent)</span>
                    }
                    else
                    {
                        <span class="text-muted">(foreløpig – attest ikke godkjent)</span>
                    }
                </dd>
                <dt class="col-sm-5">Registrerte timer</dt>
                <dd class="col-sm-7">@guidanceCalculation.RegisteredGuidanceHours.ToString("0.##")</dd>
                <dt class="col-sm-5">For-/etterarbeid</dt>
                <dd class="col-sm-7">@((guidanceCalculation.GuidancePaidHours - guidanceCalculation.RegisteredGuidanceHours).ToString("0.##")) timer</dd>
                <dt class="col-sm-5">Honorerbare timer</dt>
                <dd class="col-sm-7">@guidanceCalculation.GuidancePaidHours.ToString("0.##")</dd>
                <dt class="col-sm-5">Maksimalgrense</dt>
                <dd class="col-sm-7">@guidanceCalculation.GuidanceHonorariumMaximumAmount.ToString("N2") kr; etter grense: @guidanceCalculation.GuidanceHonorariumCappedAmount.ToString("N2") kr</dd>
                @if (!string.IsNullOrWhiteSpace(guidanceCalculation.RateSetName))
                {
                    <dt class="col-sm-5">Satssett</dt>
                    <dd class="col-sm-7">@guidanceCalculation.RateSetName
                        @if (guidanceCalculation.RateSetValidFrom.HasValue || guidanceCalculation.RateSetValidTo.HasValue)
                        {
                            <span class="text-muted">(@(guidanceCalculation.RateSetValidFrom?.ToString("dd.MM.yyyy") ?? "-") - @(guidanceCalculation.RateSetValidTo?.ToString("dd.MM.yyyy") ?? "-"))</span>
                        }
                    </dd>
                }
            </dl>
        }
    </section>

    @if (approval is not null && approval.Status == GuidanceApprovalStatus.Pending)
    {
        <section class="card card-body border-0 shadow-sm mb-4">
            <h2 class="h4">Godkjenningshandlinger</h2>
            <form asp-action="Approve" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="form-check mb-3 @(approvalConfirmationError is not null ? "text-danger" : string.Empty)">
                    <input class="form-check-input @(approvalConfirmationError is not null ? "is-invalid" : string.Empty)" type="checkbox" name="confirmsAccuracy" value="true" id="confirmsAccuracy" required aria-invalid="@(approvalConfirmationError is not null ? "true" : "false")" aria-describedby="@(approvalConfirmationError is not null ? "approval-confirmation-error" : null)" />
                    <label class="form-check-label" for="confirmsAccuracy">@(approvalConfirmationError is not null ? "⚠ " : string.Empty)Jeg har kontrollert veiledningsattesten og bekrefter at opplysningene er riktige.</label>
                    @if (approvalConfirmationError is not null)
                    {
                        <div id="approval-confirmation-error" class="invalid-feedback d-block">@approvalConfirmationError</div>
                    }
                </div>
                <button type="submit" class="btn btn-primary">Godkjenn veiledningstimer</button>
            </form>

            <hr class="my-4" />

            <form asp-action="RequestCorrection" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="mb-3">
                    <label for="reason" class="form-label">@(correctionReasonError is not null ? "⚠ " : string.Empty)Begrunnelse for korrigering</label>
                    <textarea class="form-control @(correctionReasonError is not null ? "is-invalid" : string.Empty)" id="reason" name="reason" rows="4" maxlength="1000" required aria-invalid="@(correctionReasonError is not null ? "true" : "false")" aria-describedby="@(correctionReasonError is not null ? "correction-reason-error" : null)" placeholder="F.eks. Det er registrert 3 timer 19. oktober, men vi gjennomførte bare 2 timer.">@correctionReason</textarea>
                    @if (correctionReasonError is not null)
                    {
                        <div id="correction-reason-error" class="invalid-feedback d-block">@correctionReasonError</div>
                    }
                </div>
                <button type="submit" class="btn btn-outline-warning">Be om korrigering</button>
            </form>
        </section>
    }
    else if (approval is not null && approval.Status == GuidanceApprovalStatus.Approved)
    {
        <section class="card card-body border-0 shadow-sm mb-4">
            <h2 class="h4">Godkjenningsstatus</h2>
            <p class="mb-0">Veiledningstimene er godkjent av @approval.ApprovedBy den @(approval.ApprovedAtUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-").</p>
        </section>
    }
    else if (approval is not null && approval.Status == GuidanceApprovalStatus.NeedsCorrection)
    {
        <section class="card card-body border-0 shadow-sm mb-4">
            <h2 class="h4">Korrigering nødvendig</h2>
            <p class="mb-2">ALIS må rette opp veiledningstimmene og sende attesten på nytt til godkjenning.</p>
            @if (!string.IsNullOrWhiteSpace(approval.RequestedRevisionReason))
            {
                <p class="mb-0"><strong>Begrunnelse:</strong> @approval.RequestedRevisionReason</p>
            }
        </section>
    }

    <div class="mt-4">
        <a class="btn btn-outline-secondary" asp-controller="Guidance" asp-action="Index">Tilbake til oversikten</a>
    </div>
</div>
