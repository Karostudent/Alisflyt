@model Alisflyt.Web.ViewModels.Portals.PortalEntryViewModel

@{
	ViewData["Title"] = "Portal";
}

<div class="container">
	<div class="row mb-4">
		<div class="col-12">
			<h1 class="display-6">ALISflyt — Demoportal</h1>
			<p class="lead">ALISflyt er et forslag til en digital arbeidsflate for søknad og behandling av kommunale ALIS-tilskudd. Informasjon registreres én gang og gjenbrukes gjennom prosessen, slik at brukerne får bedre oversikt og koordinator kan bruke mer tid på kontroll og behandling.</p>
			<p class="text-muted">Dette er en tidlig prototype med testdata.</p>
			<div class="alert alert-warning" role="alert">@Model.DemoNotice</div>
		</div>
	</div>

	<!-- Role cards -->
	<div class="row g-3 mb-4">
		<div class="col-12 col-md-4 d-flex">
			<div class="card w-100 shadow-sm d-flex flex-column">
				<div class="card-body d-flex flex-column">
				<h5 class="card-title">ALIS</h5>
				<ul class="card-text mb-3">
					<li>Opprett søknad og lagre utkast</li>
					<li>Rediger og send inn søknad</li>
					<li>Se returbegrunnelse og tidspunkt ved retur</li>
				</ul>
					<div class="mt-auto">
						<a asp-controller="Alis" asp-action="Index" class="btn btn-primary">Gå til ALIS</a>
					</div>
				</div>
			</div>
		</div>

		<div class="col-12 col-md-4 d-flex">
			<div class="card w-100 shadow-sm d-flex flex-column">
				<div class="card-body d-flex flex-column">
				<h5 class="card-title">Koordinator</h5>
				<ul class="card-text mb-3">
					<li>Oversikt over mottatte søknader</li>
					<li>Start behandling av innsendte saker</li>
					<li>Returner sak for korrigering (med begrunnelse)</li>
				</ul>
					<div class="mt-auto">
						<a asp-controller="Coordinator" asp-action="Index" class="btn btn-primary">Gå til koordinator</a>
					</div>
				</div>
			</div>
		</div>

		<div class="col-12 col-md-4 d-flex">
			<div class="card w-100 shadow-sm d-flex flex-column">
				<div class="card-body d-flex flex-column">
				<h5 class="card-title">Veileder <span class="badge bg-secondary">Planlagt funksjonalitet</span></h5>
				<ul class="card-text mb-3">
					<li>Registrer/bekreft veiledningstimer</li>
					<li>Følg relevante oppgaver</li>
				</ul>
					<div class="mt-auto">
						<a asp-controller="Guidance" asp-action="Index" class="btn btn-outline-primary">Se veilederområdet</a>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Planned main process -->
	<div class="row mb-4">
		<div class="col-12">
			<h3>Planlagt hovedprosess</h3>
			<p class="text-muted">Dette viser målbildet for hele løpet fra søknad til utbetaling. Ikke alle trinn er implementert ennå.</p>
		</div>

		<div class="col-12">
			<div class="d-flex flex-column flex-md-row align-items-start gap-3">
				<div class="border rounded p-3 flex-grow-1 text-center">
					<strong>ALIS søker</strong>
				</div>
				<div class="border rounded p-3 flex-grow-1 text-center">
					<strong>Registrering og avstemming av veiledning</strong>
				</div>
				<div class="border rounded p-3 flex-grow-1 text-center">
					<strong>Kontroll og avvik</strong>
				</div>
				<div class="border rounded p-3 flex-grow-1 text-center">
					<strong>Beregning av tilskudd</strong>
				</div>
				<div class="border rounded p-3 flex-grow-1 text-center">
					<strong>Revisorgodkjenning av beregningsgrunnlag</strong>
				</div>
				<div class="border rounded p-3 flex-grow-1 text-center">
					<strong>Innsending til Helsedirektoratet</strong>
				</div>
				<div class="border rounded p-3 flex-grow-1 text-center">
					<strong>Mottak av vedtak</strong>
				</div>
				<div class="border rounded p-3 flex-grow-1 text-center">
					<strong>Fordeling og utbetaling</strong>
				</div>
			</div>
		</div>

		<div class="col-12 mt-3">
			<div class="card shadow-sm">
				<div class="card-body">
					<h5 class="card-title">Planlagt funksjonalitet</h5>
					<ul class="mb-0">
						<li>Automatisk avstemming av veiledningstimer og varsling ved avvik</li>
						<li>Regelstyrt beregning og fordelingsgrunnlag for tilskudd</li>
						<li>Sporbar revisorgodkjenning med dokumentasjon i saken</li>
						<li>Varsling til relevante roller og økonomiavdeling ved vedtak</li>
						<li>Rapportering og eksport</li>
					</ul>
				</div>
			</div>
		</div>
	</div>

	<!-- Demonstrable features -->
	<div class="row mb-4">
		<div class="col-12 col-md-8">
			<h3>Dette kan demonstreres nå</h3>
			<ul>
				<li>Opprette og lagre utkast</li>
				<li>Redigere søknadsopplysninger</li>
				<li>Validere og sende inn søknad</li>
				<li>Se samme sak fra ALIS- og koordinatorperspektiv</li>
				<li>Koordinator kan starte behandling av innsendinger</li>
				<li>Koordinator kan returnere en sak for korrigering med obligatorisk begrunnelse</li>
				<li>ALIS ser returbegrunnelse og tidspunkt, kan redigere og sende inn på nytt</li>
				<li>Norske statusetiketter vises i grensesnittet</li>
			</ul>
		</div>
		<div class="col-12 col-md-4">
			<h5>Prototype</h5>
			<p class="small text-muted">Dette er en prototype med testdata. Innlogging, tilgangsstyring og full saksbehandling er ikke implementert.</p>
		</div>
	</div>
</div>

