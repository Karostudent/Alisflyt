@model Alisflyt.Web.ViewModels.Dashboards.GuidanceDashboardViewModel
@{
    ViewData["Title"] = "Min veiledning";
}

<div class="container py-4">
    <header class="mb-4">
        <p class="text-uppercase text-primary fw-semibold mb-1">VEILEDER</p>
        <h1 class="mb-2">Min veiledning</h1>
        <p class="mb-0 text-muted">@Model.Message</p>
        @if (!string.IsNullOrWhiteSpace(Model.CurrentUserName))
        {
            <p class="mb-0 text-muted">Innlogget veileder: <strong>@Model.CurrentUserName</strong></p>
        }
    </header>

    <section class="card card-body mb-4">
        <h2 class="h5 mb-3">Tilknyttede ALIS-leger</h2>
        @if (Model.AssignedDoctors.Count == 0)
        {
            <p class="text-muted mb-0">Ingen ALIS-leger er tilknyttet deg.</p>
        }
        else
        {
            <ul class="list-inline mb-0">
                @foreach (var doctor in Model.AssignedDoctors)
                {
                    <li class="list-inline-item badge bg-light text-dark border me-2">@doctor</li>
                }
            </ul>
        }
    </section>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <h2 class="h5 text-muted">Til godkjenning</h2>
                    <p class="display-6 mb-0">@Model.PendingCount</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <h2 class="h5 text-muted">Korrigering nødvendig</h2>
                    <p class="display-6 mb-0">@Model.NeedsCorrectionCount</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <h2 class="h5 text-muted">Godkjente attester</h2>
                    <p class="display-6 mb-0">@Model.ApprovedCount</p>
                </div>
            </div>
        </div>
    </div>

    <section class="card card-body" aria-labelledby="guidance-heading">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h2 id="guidance-heading" class="h4 mb-0">Relevante attester</h2>
            <a asp-controller="Guidance" asp-action="Applications" class="btn btn-outline-primary">Se søknadsoversikt</a>
        </div>

        @if (Model.Cases.Count == 0)
        {
            <p class="text-muted mb-0">Ingen attester er tilgjengelige for din tilknytning.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0 sortable-table">
                    <thead>
                        <tr>
                            <th scope="col" data-sortable="true" data-sort-type="text" tabindex="0" role="button" aria-sort="none">ALIS-lege <span class="sort-indicator"></span></th>
                            <th scope="col" data-sortable="true" data-sort-type="text" tabindex="0" role="button" aria-sort="none">Saksnummer <span class="sort-indicator"></span></th>
                            <th scope="col" data-sortable="true" data-sort-type="text" tabindex="0" role="button" aria-sort="none">Periode <span class="sort-indicator"></span></th>
                            <th scope="col" data-sortable="true" data-sort-type="number" tabindex="0" role="button" aria-sort="none">Timer <span class="sort-indicator"></span></th>
                            <th scope="col" data-sortable="true" data-sort-type="status" tabindex="0" role="button" aria-sort="none">Status <span class="sort-indicator"></span></th>
                            <th scope="col" data-sortable="true" data-sort-type="date" tabindex="0" role="button" aria-sort="none">Sist endret <span class="sort-indicator"></span></th>
                            <th scope="col">Handling</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Cases)
                        {
                            <tr>
                                <td>@item.DoctorName @if (!string.IsNullOrWhiteSpace(item.HprNumber)) { <span class="text-muted small">(@item.HprNumber)</span> }</td>
                                <td>@item.CaseNumber</td>
                                <td>@item.PeriodText</td>
                                <td data-sort-value="@item.TotalHours.ToString(System.Globalization.CultureInfo.InvariantCulture)">@item.TotalHours.ToString("0.##")</td>
                                <td data-sort-value="@item.Status"><span class="badge text-bg-light border">@item.StatusText</span></td>
                                <td data-sort-value="@item.LastModifiedAtUtc.ToString("o")">@item.LastModifiedAtUtc.ToLocalTime().ToString("g")</td>
                                <td><a asp-controller="Supervisor" asp-action="Details" asp-route-id="@item.Id">Se veiledningstimer</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
