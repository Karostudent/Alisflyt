@model Alisflyt.Web.ViewModels.Dashboards.GuidanceDashboardViewModel
@{ ViewData["Title"] = "Veileder – oversikt"; }
<link rel="stylesheet" href="~/css/public-dashboards.css" asp-append-version="true" />
<div class="public-dashboard">
    <nav aria-label="Brødsmuler" class="public-breadcrumb"><a asp-controller="Portal" asp-action="Index">Portal</a><span aria-hidden="true"> / </span><span>Veileder</span></nav>
    <header class="public-page-heading">
        <div><p class="public-role">VEILEDER</p><h1>Veilederoversikt</h1><p>Kontroller registrert veiledning og godkjenn veiledningsattester.</p></div>
    </header>
    <div class="public-information" role="note">
        <strong>Om demoversjonen</strong>
        <p>Personlig oversikt over dine ALIS-leger er under utvikling. Du kan åpne demosaker fra veileders søknadsoversikt. Godkjenning registreres uten innlogging eller elektronisk signatur.</p>
    </div>
    <section class="public-case-section" aria-labelledby="guidance-heading">
        <h2 id="guidance-heading">Veiledningsattester</h2>
        <p>ALIS fører dato, varighet og tema for øktene. Som veileder kontrollerer du at opplysningene stemmer.</p>
        <a asp-controller="Guidance" asp-action="Applications" class="btn btn-primary">Åpne søknadsoversikten</a>
        <div class="public-guidance-help">
            <h3>Slik finner du attesten</h3>
            <ol>
                <li>Åpne veileders søknadsoversikt.</li>
                <li>Finn søknaden og velg «Kontroller attest».</li>
                <li>Kontroller øktene og godkjenn attesten.</li>
            </ol>
        </div>
    </section>
</div>
