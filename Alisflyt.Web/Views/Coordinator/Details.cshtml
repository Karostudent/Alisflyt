@model Alisflyt.Web.ViewModels.Coordinator.CoordinatorCaseDetailsViewModel

@{
    ViewData["Calculation"] = Model.Calculation;
	ViewData["Title"] = "Sak (Koordinator)";
	ViewData["RoleHelpText"] = "Her behandles innsendte søknader.";
	var statusText = Model.Status switch
	{
		Alisflyt.Domain.Enums.GrantCaseStatus.Draft => "Utkast",
		Alisflyt.Domain.Enums.GrantCaseStatus.Submitted => "Innsendt",
		Alisflyt.Domain.Enums.GrantCaseStatus.UnderReview => "Under behandling",
		Alisflyt.Domain.Enums.GrantCaseStatus.ReturnedForCorrection => "Returnert for korrigering",
		Alisflyt.Domain.Enums.GrantCaseStatus.AwaitingAuditorApproval => "Klar for revisorkontroll",
		_ => Model.Status.ToString()
	};
}

<partial name="~/Views/Shared/_RoleContextPartial.cshtml" model='@("Koordinatorvisning")' />

<h2>Sak @Model.CaseNumber</h2>
<p><a asp-controller="GrantCases" asp-action="Application" asp-route-id="@Model.Id">Vis hele søknaden og veiledningsattesten</a></p>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
<section class="card card-body mb-4">
    <h3>Sentralitetstillegg ? koordinator</h3>
    @if (Model.Status == Alisflyt.Domain.Enums.GrantCaseStatus.AwaitingAuditorApproval)
    {
        <div aria-disabled="true">
            <p><strong>Har kommunen sentralitetsgrad 6?</strong> @(Model.ApplicationData?.IsCentralityGrade6 == true ? "Ja" : Model.ApplicationData?.IsCentralityGrade6 == false ? "Nei" : "Ikke oppgitt")</p>
            <p><strong>Søkt beløp for sentralitetstillegg:</strong> @(Model.ApplicationData?.CentralitySupplementRequestedAmount?.ToString("N2") ?? "Ikke oppgitt") kr</p>
            <button type="button" class="btn btn-secondary" disabled aria-disabled="true">&#128274; Redigering låst</button>
            <p class="form-text">Opplysningene er låst fordi saken er klar for revisorkontroll.</p>
        </div>
    }
    else
    {
        <form asp-action="SaveCentrality" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <fieldset class="mb-3">
                <legend>Har kommunen sentralitetsgrad 6?</legend>
                <label><input type="radio" name="grade6" value="true" checked="@(Model.ApplicationData?.IsCentralityGrade6 == true)" required /> Ja</label>
                <label class="ms-3"><input type="radio" name="grade6" value="false" checked="@(Model.ApplicationData?.IsCentralityGrade6 == false)" required /> Nei</label>
            </fieldset>
            <label for="centrality-amount" class="form-label">Søkt beløp for sentralitetstillegg (kr)</label>
            <input id="centrality-amount" name="amount" type="number" min="0" step="0.01" value="@Model.ApplicationData?.CentralitySupplementRequestedAmount?.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control mb-3" />
            <p class="form-text">Beløp må oppgis når kommunen har sentralitetsgrad 6.</p>
            <button class="btn btn-primary" type="submit">Lagre sentralitetsopplysninger</button>
        </form>
    }
</section>
<dl class="row">
	<dt class="col-sm-3">@Html.DisplayNameFor(m => m.CaseNumber)</dt>
	<dd class="col-sm-9">@Model.CaseNumber</dd>

	<dt class="col-sm-3">@Html.DisplayNameFor(m => m.HprNumber)</dt>
	<dd class="col-sm-9">@Model.HprNumber</dd>

	<dt class="col-sm-3">@Html.DisplayNameFor(m => m.EmploymentPercentage)</dt>
	<dd class="col-sm-9">@((Model.EmploymentPercentage.HasValue) ? $"{Model.EmploymentPercentage.Value:0.##} %" : "-")</dd>

	<dt class="col-sm-3">Periode</dt>
	<dd class="col-sm-9">@Model.EmploymentStartDate?.ToString() - @Model.EmploymentEndDate?.ToString()</dd>

	<dt class="col-sm-3">@Html.DisplayNameFor(m => m.Status)</dt>
	<dd class="col-sm-9">@statusText</dd>

	<dt class="col-sm-3">@Html.DisplayNameFor(m => m.CreatedAtUtc)</dt>
	<dd class="col-sm-9">@Model.CreatedAtUtc.ToLocalTime().ToString("g")</dd>

	<dt class="col-sm-3">@Html.DisplayNameFor(m => m.LastModifiedAtUtc)</dt>
	<dd class="col-sm-9">@Model.LastModifiedAtUtc.ToLocalTime().ToString("g")</dd>
</dl>

	@await Html.PartialAsync("~/Views/Shared/_ApplicationDetailsPartial.cshtml", Model.ApplicationData)

	@await Html.PartialAsync("~/Views/Shared/_CalculationResultPartial.cshtml", Model.Calculation)

<div class="mt-3">
	<a asp-action="Index" class="btn btn-secondary">Tilbake</a>
</div>

<div class="mt-4 alert alert-secondary">
	<h5>Planlagte prosessteg</h5>
	<ul>
		<li>Revisjon (revisor-del)</li>
		<li>Send til Helsedirektoratet</li>
	</ul>
</div>

@if (Model.Status == Alisflyt.Domain.Enums.GrantCaseStatus.Submitted)
{
	<form asp-action="StartReview" method="post">
		@Html.AntiForgeryToken()
		<input type="hidden" name="id" value="@Model.Id" />
		<button type="submit" class="btn btn-primary">Start behandling</button>
	</form>
}

@if (Model.Status is Alisflyt.Domain.Enums.GrantCaseStatus.UnderReview or Alisflyt.Domain.Enums.GrantCaseStatus.AwaitingAuditorApproval)
{
	<a asp-action="ExportExcel" asp-route-id="@Model.Id" class="btn btn-success">Eksporter til Excel</a>
}

@if (Model.Status == Alisflyt.Domain.Enums.GrantCaseStatus.UnderReview)
{
	<a asp-action="ReturnForCorrection" asp-route-id="@Model.Id" class="btn btn-warning">Returner for korrigering</a>
	<form asp-action="MarkReadyForAuditorApproval" method="post" class="d-inline" onsubmit="return confirm('Vil du markere søknaden som klar for revisorkontroll?');">
		@Html.AntiForgeryToken()
		<input type="hidden" name="id" value="@Model.Id" />
		<button type="submit" class="btn btn-primary">Marker klar for revisorkontroll</button>
	</form>
}

@if (Model.Status == Alisflyt.Domain.Enums.GrantCaseStatus.AwaitingAuditorApproval)
{
	<div class="alert alert-success mt-3">
		<h5>Klar for revisorkontroll</h5>
		<p>Kommunens behandling er ferdigstilt. Søknaden er klar for revisors kontroll før eventuell innsending til Helsedirektoratet. Søknaden er ikke oversendt fra ALISflyt.</p>
		<p class="mb-0">Ferdigstilt: @Model.ReadyForAuditorApprovalAtUtc?.ToLocalTime().ToString("g")</p>
	</div>
}

@if (Model.Status == Alisflyt.Domain.Enums.GrantCaseStatus.ReturnedForCorrection)
{
	<div class="alert alert-warning mt-3">
		<h5>Saken er returnert for korrigering</h5>
		<p><strong>Begrunnelse:</strong> @Model.ReturnReason</p>
		<p><strong>Returnert:</strong> @Model.ReturnedAtUtc?.ToLocalTime().ToString("g")</p>
	</div>
}
