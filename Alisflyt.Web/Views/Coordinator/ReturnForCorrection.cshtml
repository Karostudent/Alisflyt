@model Alisflyt.Web.ViewModels.Coordinator.ReturnForCorrectionViewModel

@{
	ViewData["Title"] = "Returner sak for korrigering";
}

<h2>Returner sak @Model.CaseNumber</h2>

@using (Html.BeginForm(null, null, FormMethod.Post))
{
	@Html.AntiForgeryToken()
	<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

	<div class="mb-3">
		<label asp-for="Reason" class="form-label">
			@if (ViewData.ModelState[nameof(Model.Reason)]?.Errors.Count > 0) { <span class="text-danger" aria-hidden="true">⚠</span> }
		</label>
		<textarea asp-for="Reason" class="form-control @(ViewData.ModelState[nameof(Model.Reason)]?.Errors.Count > 0 ? "is-invalid" : string.Empty)" rows="6" maxlength="1000" aria-invalid="@(ViewData.ModelState[nameof(Model.Reason)]?.Errors.Count > 0 ? "true" : "false")" aria-describedby="@(ViewData.ModelState[nameof(Model.Reason)]?.Errors.Count > 0 ? "reason-error" : null)"></textarea>
		<span id="reason-error" asp-validation-for="Reason" class="text-danger"></span>
	</div>

	<button type="submit" class="btn btn-warning">Returner til ALIS</button>
	<a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Avbryt</a>
}
