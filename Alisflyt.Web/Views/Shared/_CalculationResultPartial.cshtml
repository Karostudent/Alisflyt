@model Alisflyt.Application.Models.GrantCalculationDetailsDto

<div class="calculation-result">
	<h3>Beregningsresultat</h3>
	@if (Model is null || !Model.IsAvailable)
	{
		<div class="alert alert-info">@((Model?.UnavailableReason) ?? "Beregning ikke tilgjengelig for denne søknaden.")</div>
	}
	else
	{
		<table class="table table-sm">
			<tbody>
				<tr data-practice-maximum="@Model.PracticeCompensationMaximumAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)"><th>Praksiskompensasjon</th><td>@Model.PracticeCompensationAmount.ToString("N0") kr
                    @if (Model.IsPracticeCompensationCapped)
                    {
                        <span class="small text-muted ms-2">Maksgrense: @Model.PracticeCompensationMaximumAmount.ToString("N2") kr for valgt stilling og periode.</span>
                    }
                </td></tr>
				<tr><th>Læringsaktiviteter</th><td>@Model.LearningActivitiesAmount.ToString("N0") kr</td></tr>
				<tr><th>Produktivitetselement</th><td>@Model.ProductivityAmount.ToString("N0") kr</td></tr>
				<tr><th>Tilskudd til veiledning</th><td data-guidance-amount>@Model.GuidanceAmount.ToString("N0") kr</td></tr>
				<tr><th>Tilrettelegging</th><td>@Model.FacilitationAmount.ToString("N0") kr</td></tr>
				<tr><th>Sentralitetstillegg</th><td>@Model.CentralitySupplementAmount.ToString("N0") kr</td></tr>
		@if (!string.IsNullOrWhiteSpace(Model.CentralityExplanation))
		{
			<tr><td></td><td><div class="small text-muted">@Model.CentralityExplanation</div></td></tr>
		}
				<tr class="table-primary"><th>Beregnet samlet tilskuddsgrunnlag</th><th>@Model.TotalAmount.ToString("N0") kr</th></tr>
			</tbody>
		</table>
		<p class="small text-muted">Summen er kommunens samlede beregnede tilskuddsgrunnlag for kostnader knyttet til ALIS-spesialiseringen. Den viser ikke hva som faktisk tilfaller ALIS-legen eller hvordan beløpet fordeles. Helsedirektoratet behandler søknaden og fastsetter eventuelt tilskudd.</p>
		<div class="small text-muted">Satssett: @Model.RateSetName (@Model.RateSetValidFrom?.ToString("dd.MM.yyyy") - @Model.RateSetValidTo?.ToString("dd.MM.yyyy"))</div>
	}
</div>