@model Alisflyt.Web.ViewModels.Admin.AdminDashboardViewModel
@{
	ViewData["Title"] = "Administrator";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
	<div>
		<h1 class="h2 mb-1">Administrator</h1>
		<p class="text-muted mb-0">Logget inn som @Model.CurrentUser?.Name</p>
	</div>
	<span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle">Administrasjonsvisning</span>
</div>

<div class="row g-4 mb-4">
	<div class="col-md-4">
		<div class="card h-100 shadow-sm border-0">
			<div class="card-body">
				<h2 class="h6 text-uppercase text-muted">Saker</h2>
				<div class="display-6 fw-semibold">@Model.Cases.Count</div>
				<p class="mb-0 text-muted">Totalt antall saker i løsningen</p>
			</div>
		</div>
	</div>

	<div class="col-md-4">
		<div class="card h-100 shadow-sm border-0">
			<div class="card-body">
				<h2 class="h6 text-uppercase text-muted">Satssett</h2>
				<div class="display-6 fw-semibold">@Model.RateSets.Count</div>
				<p class="mb-0 text-muted">Tilgjengelige satsperioder</p>
			</div>
		</div>
	</div>

	<div class="col-md-4">
		<div class="card h-100 shadow-sm border-0">
			<div class="card-body">
				<h2 class="h6 text-uppercase text-muted">Status</h2>
				<div class="display-6 fw-semibold">Demo</div>
				<p class="mb-0 text-muted">Administrasjon er satt opp som presentasjonsmodell</p>
			</div>
		</div>
	</div>
</div>

<div class="row g-4">
	<div class="col-lg-7">
		<div class="card shadow-sm border-0">
			<div class="card-header bg-body-tertiary">Alle saker</div>
			<div class="card-body p-0">
				<div class="table-responsive">
					<table class="table table-striped mb-0">
						<thead>
							<tr>
								<th>Saksnummer</th>
								<th>HPR</th>
								<th>Status</th>
								<th>Endret</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in Model.Cases)
							{
								<tr>
									<td>@item.CaseNumber</td>
									<td>@item.HprNumber</td>
									<td>@item.Status</td>
									<td>@item.LastModifiedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>

	<div class="col-lg-5">
		<div class="card shadow-sm border-0">
			<div class="card-header bg-body-tertiary">Satssett</div>
			<div class="card-body">
				@if (Model.RateSets.Count == 0)
				{
					<p class="text-muted mb-0">Ingen satssett er registrert.</p>
				}
				else
				{
					<ul class="list-group list-group-flush">
						@foreach (var rateSet in Model.RateSets)
						{
							<li class="list-group-item px-0">
								<div class="d-flex justify-content-between align-items-start gap-3">
									<div>
										<strong>@rateSet.Name</strong>
										<div class="small text-muted">@rateSet.ValidFrom.ToString("dd.MM.yyyy") – @rateSet.ValidTo.ToString("dd.MM.yyyy")</div>
									</div>
									<span class="badge @(rateSet.IsActive ? "bg-success" : "bg-secondary")">@(rateSet.IsActive ? "Aktiv" : "Inaktiv")</span>
								</div>
							</li>
						}
					</ul>
				}
			</div>
		</div>
	</div>
</div>
