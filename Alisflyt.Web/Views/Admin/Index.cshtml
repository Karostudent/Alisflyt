@model Alisflyt.Web.ViewModels.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "Administrator";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h2 mb-1">Administrator</h1>
        <p class="text-muted mb-0">Logget inn som @Model.CurrentUserName</p>
    </div>
    <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle">Brukeradministrasjon</span>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<div asp-validation-summary="All" class="text-danger"></div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-body-tertiary">Opprett bruker</div>
            <div class="card-body">
                <form asp-action="CreateUser" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label" for="UserName">Brukernavn</label>
                        <input class="form-control" id="UserName" name="UserName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Email">E-post</label>
                        <input class="form-control" id="Email" name="Email" type="email" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Password">Midlertidig passord</label>
                        <input class="form-control" id="Password" name="Password" type="password" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Role">Rolle</label>
                        <select class="form-select" id="Role" name="Role" required>
                            <option value="">Velg rolle</option>
                            @foreach (var role in Model.Roles)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="HprNumber">Veilederens HPR-nummer</label>
                        <input class="form-control" id="HprNumber" name="HprNumber" maxlength="50" />
                        <div class="form-text">Påkrevd når rollen er Veileder.</div>
                    </div>
                    <button class="btn btn-primary" type="submit">Opprett bruker</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-body-tertiary">Registrerte brukere</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Brukernavn</th>
                                <th>E-post</th>
                                <th>HPR</th>
                                <th>Rolle</th>
                                <th><span class="visually-hidden">Handling</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td>@user.UserName</td>
                                    <td>@user.Email</td>
                                    <td>@user.HprNumber</td>
                                    <td>@string.Join(", ", user.Roles)</td>
                                    <td>
                                        <form asp-action="UpdateRole" method="post" class="d-flex gap-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="UserId" value="@user.Id" />
                                            <select class="form-select form-select-sm" name="Role" aria-label="Ny rolle for @user.UserName">
                                                @foreach (var role in Model.Roles)
                                                {
                                                    <option value="@role" selected="@(user.Roles.Contains(role) ? "selected" : null)">@role</option>
                                                }
                                            </select>
                                            <button class="btn btn-outline-secondary btn-sm" type="submit">Lagre</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
