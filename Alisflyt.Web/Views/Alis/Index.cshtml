@model Alisflyt.Web.ViewModels.Dashboards.AlisDashboardViewModel

@{
	ViewData["Title"] = "ALIS – søknadsoversikt";
}

<link rel="stylesheet" href="~/css/public-dashboards.css" asp-append-version="true" />
<div class="public-dashboard">
<nav aria-label="Brødsmuler" class="public-breadcrumb"><a asp-controller="Portal" asp-action="Index">Portal</a><span aria-hidden="true"> / </span><span>ALIS</span></nav>
<header class="public-page-heading">
	<div><p class="public-role">ALIS</p><h1>Søknadsoversikt</h1><p>Her finner du lagrede søknader og følger status på sakene.</p></div>
	<a asp-controller="GrantCases" asp-action="Create" class="btn btn-primary">Ny søknad</a>
</header>

<div class="public-information" role="note"><strong>Om demoversjonen</strong><p>I denne demoversjonen vises testdata. I ferdig løsning skal ALIS bare se egne søknader.</p></div>

<section class="public-case-section" aria-labelledby="case-list-heading">
<h2 id="case-list-heading">Søknader</h2>
<form method="get" class="public-filter">
	<label for="case-status">Vis saker med status</label>
	<select id="case-status" name="status" class="form-select">
		<option value="All" selected='@(Model.Filter == "All" ? "selected" : null)'>Alle</option>
		<option value="Draft" selected='@(Model.Filter == "Draft" ? "selected" : null)'>Utkast</option>
		<option value="Submitted" selected='@(Model.Filter == "Submitted" ? "selected" : null)'>Innsendt</option>
		<option value="UnderReview" selected='@(Model.Filter == "UnderReview" ? "selected" : null)'>Under behandling</option>
		<option value="ReturnedForCorrection" selected='@(Model.Filter == "ReturnedForCorrection" ? "selected" : null)'>Returnert for korrigering</option>
	</select>
<button type="submit" class="btn btn-outline-primary">Vis saker</button>
</form>

<div class="table-responsive">
<table class="table public-case-table">
<caption class="visually-hidden">Søknader med valgt status</caption>
	<thead>
		<tr>
			<th scope="col">Saksnummer</th>
			<th>HPR</th>
			<th>Status</th>
			<th>Sist endret</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
@foreach(var c in Model.Cases)
{
		<tr>
			<td class="public-case-number">@c.CaseNumber</td>
			<td>@c.HprNumber</td>
		<td><span class="public-status public-status-@c.Status">@(c.Status == Alisflyt.Domain.Enums.GrantCaseStatus.Draft ? "Utkast" : c.Status == Alisflyt.Domain.Enums.GrantCaseStatus.Submitted ? "Innsendt" : c.Status == Alisflyt.Domain.Enums.GrantCaseStatus.UnderReview ? "Under behandling" : c.Status == Alisflyt.Domain.Enums.GrantCaseStatus.ReturnedForCorrection ? "Returnert for korrigering" : c.Status.ToString())</span></td>
			<td>@c.LastModifiedAtUtc.ToLocalTime().ToString("g")</td>
			<td><a asp-controller="GrantCases" asp-action="Details" asp-route-id="@c.Id" aria-label="Åpne søknad @c.CaseNumber">Åpne søknad</a></td>
		</tr>
}
@if (!Model.Cases.Any())
{
    <tr><td colspan="5" class="public-empty">Ingen søknader med valgt status. Velg en annen status eller opprett en ny søknad.</td></tr>
}
	</tbody>
</table>

</div>
</section>
</div>
