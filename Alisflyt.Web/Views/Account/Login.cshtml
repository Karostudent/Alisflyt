@model IEnumerable<Alisflyt.Web.Models.DemoUser>
@{
	ViewData["Title"] = "Demo innlogging";
}

<div class="row justify-content-center">
	<div class="col-lg-8">
		<div class="card shadow-sm border-0">
			<div class="card-body p-4 p-lg-5">
				<h1 class="h2 mb-3">Velg demo-bruker</h1>
				<p class="text-muted mb-4">
					Dette er en demonstrasjonsinnlogging for presentasjonsformål. Brukerne er forsynt med eksempeldata for ALIS, veileder, koordinator og administrator.
				</p>

				<div class="row g-3">
					@foreach (var user in Model)
					{
						<div class="col-md-6 col-xl-3 d-flex">
							<div class="card border-0 shadow-sm w-100 h-100">
								<div class="card-body d-flex flex-column">
									<span class="badge bg-primary-subtle text-primary-emphasis align-self-start mb-2">@user.Role</span>
									<h2 class="h5">@user.Name</h2>
									<p class="text-muted small mb-3">HPR: @user.HprNumber</p>

									<form asp-action="Login" asp-controller="Account" method="post" class="mt-auto">
										@Html.AntiForgeryToken()
										<input type="hidden" name="role" value="@user.Role" />
										<button type="submit" class="btn btn-primary w-100">Logg inn som @user.Role</button>
									</form>
								</div>
							</div>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
</div>
