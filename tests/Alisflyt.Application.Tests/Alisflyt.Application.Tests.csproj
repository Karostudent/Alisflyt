	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<IsTestProject>true</IsTestProject>
	<RootNamespace>Alisflyt.Application.Tests</RootNamespace>
	<AssemblyName>Alisflyt.Application.Tests</AssemblyName>
